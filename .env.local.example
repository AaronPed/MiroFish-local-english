# LLM（OpenAI-compatible；用百炼就用 compatible-mode）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3-max

GRAPHITI_LLM_MODEL=qwen3-max
GRAPHITI_EMBEDDING_MODEL=text-embedding-v4

# 本地图谱后端
ZEP_BACKEND=graphiti
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# =============================================================================
# 可选配置（Hardening）
# =============================================================================
# GRAPHITI_ASYNC_TIMEOUT=300           # 异步操作超时（秒），默认 300
# GRAPHITI_EMBEDDING_BATCH_SIZE=10     # Embedding 批次大小，默认 10
# GRAPHITI_DISABLE_PATCH=0             # 禁用 monkey-patch（upstream 修复后设为 1）